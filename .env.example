# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Market Data & Alternative Providers (FRED & Quandl require keys)
TIINGO_API_KEY=""
FRED_API_KEY=""
QUANDL_API_KEY=""
# Note: UK ONS CPIH and FCA Net Short Register are free public open data (no API key required)

# Telegram Alerting
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
